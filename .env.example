# Configuración del panel de administración (/admin).
# Copiá este archivo como .env.local y completá los valores. .env.local no se sube a GitHub.
#
# Para generar la clave y el secreto:
#   node scripts/generar-clave-admin.mjs "tu-clave-segura"
#
# Nunca se guarda la contraseña en texto plano: solo su hash.

ADMIN_USUARIO=admin
ADMIN_PASSWORD_HASH=scrypt:sal:hash
ADMIN_SESSION_SECRET=cadena-larga-al-azar
